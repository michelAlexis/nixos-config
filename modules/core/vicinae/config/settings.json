// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "theme": {
      "dark": {
         "name": "catppuccin-frappe"
      }
   },
   "launcher_window": {
      "compact_mode": {
         "enabled": false
      }
   },
   "providers": {
      "applications": {
         "entrypoints": {
            "btop": {
               "enabled": false
            },
            "gvim": {
               "enabled": false
            },
            "kitty": {
               "enabled": false
            },
            "nixos-manual": {
               "enabled": false
            },
            "nvim": {
               "enabled": false
            },
            "vim": {
               "enabled": false
            },
            "yazi": {
               "enabled": false
            }
         }
      },
      "browser-extension": {
         "enabled": false,
         "entrypoints": {
            "browse-tabs": {
               "enabled": true
            },
            "shortcut-active-tab": {
               "enabled": true
            }
         }
      },
      "clipboard": {
         "enabled": false,
         "preferences": {
            "monitoring": true,
            "ignorePasswords": true,
            "preserveTagged": true,
            "ignoredApps": [],
            "evictionThreshold": "never",
            "eraseOnStartup": false
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "indexingPaths": [
               "/home/ami"
            ],
            "excludedIndexingPaths": []
         }
      },
      "font": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "media": {
         "entrypoints": {
            "next-track": {
               "enabled": true
            },
            "now-playing": {
               "enabled": true
            },
            "play-pause": {
               "enabled": true
            },
            "previous-track": {
               "enabled": true
            },
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "logout": {
               "enabled": true
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      },
      "raycast-compat": {
         "enabled": false
      },
      "snippets": {
         "enabled": false,
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
   }
}